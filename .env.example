# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored -- never commit real secrets. `server/main.py` loads
# `.env` automatically on startup (see server/auth/config.py for the full
# list of what each variable controls). Real environment variables (e.g.
# set by docker-compose, or your hosting platform) always take priority
# over whatever is in `.env`.
#
# Nothing below is auto-generated -- there is no other "auth config file"
# to edit; server/auth/config.py builds its AuthConfig object entirely
# from these environment variables at startup.

# ------------------------------------------------------------------
# Core server / database
# ------------------------------------------------------------------

# Matches docker-compose.yml's default Postgres credentials.
DATABASE_URL=postgresql://omnilaunge:omnilaunge@localhost:5432/omnilaunge
PORT=8000
MOVE_SPEED=4
TICK_RATE=30

# Comma-separated Socket.IO CORS origins, or "*" for a fully public server.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------
# Auth: required
# ------------------------------------------------------------------

# REQUIRED. The server refuses to start without this (must be >= 32 chars).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ------------------------------------------------------------------
# Auth: registration / login modes (design doc §4)
# ------------------------------------------------------------------

# Open self-registration. Mutually exclusive with AUTH_ADMIN_ONLY_REGISTRATION.
AUTH_ENABLE_LOCAL_REGISTRATION=false
AUTH_ENABLE_LOCAL_LOGIN=true
# Only admins can create accounts (design doc §4.2).
AUTH_ADMIN_ONLY_REGISTRATION=false
# Require a verified email before local login succeeds.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Require a valid JWT on every Socket.IO connection (design doc §16). Off by
# default so the existing real-time game stays fully anonymous.
AUTH_REQUIRE_SOCKET_AUTH=false
# Whether an unauthenticated visitor can create an avatar and play at all
# ("Continue as a guest"). Set to false to require a real account for
# everyone -- hides the guest link on the login page and redirects an
# anonymous visitor away from the main game. This is a client-side UX gate;
# pair with AUTH_REQUIRE_SOCKET_AUTH=true above for real backend enforcement.
AUTH_ALLOW_GUEST_ACCESS=true

# ------------------------------------------------------------------
# Auth: password policy (design doc §5.1, §7.3)
# ------------------------------------------------------------------

AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_DIGITS=true
AUTH_PASSWORD_REQUIRE_SPECIAL=true
# How many previous passwords (counting the live one) a user cannot reuse. 0 disables the check.
AUTH_PASSWORD_HISTORY_COUNT=5
# Days after which a login soft-flags requiresPasswordChange=true. Unset/blank disables it.
AUTH_PASSWORD_EXPIRY_DAYS=

# ------------------------------------------------------------------
# Auth: sessions / tokens
# ------------------------------------------------------------------

AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_MAX_SESSIONS_PER_USER=5

# ------------------------------------------------------------------
# Auth: rate limiting / lockout (design doc §7.1, §7.2)
# ------------------------------------------------------------------

AUTH_REGISTRATION_RATE_LIMIT_PER_HOUR=10
AUTH_LOGIN_RATE_LIMIT_PER_HOUR=100
AUTH_FAILED_LOGIN_LOCKOUT_THRESHOLD=5
AUTH_FAILED_LOGIN_LOCKOUT_MINUTES=15

# ------------------------------------------------------------------
# Email (verification / password reset / admin welcome emails, §3, §20)
# ------------------------------------------------------------------

# Leave SMTP_SERVER blank to use the dev-mode fallback, which logs the
# email body instead of sending it (verification/reset links still work,
# just read them from the server log).
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@omnilaunge.local
# Used to build links inside emails (e.g. https://APP_BASE_URL/reset-password?token=...).
APP_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------
# Initial admin bootstrap (design doc §18) -- only used once, on an empty
# users table; safe to remove after the first admin has logged in.
# ------------------------------------------------------------------

INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_DISPLAY_NAME=System Administrator

# ------------------------------------------------------------------
# OAuth2 / SSO providers (design doc §4.3, §4.4) -- each provider only
# appears in GET /api/auth/providers once its client_id (and, for
# Azure/Cognito, tenant/domain) is set. Leave all blank to disable OAuth2
# entirely and use local auth only.
# ------------------------------------------------------------------

# --- Azure Entra ID ---
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
# Comma-separated Entra ID group names/IDs; if set, only members of one of
# these groups may log in (checked on every login, not just the first).
AZURE_ALLOWED_GROUPS=
# Optional override; defaults to {APP_BASE_URL}/auth-callback.html?provider=azure
AZURE_REDIRECT_URI=

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- GitHub OAuth2 ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# --- AWS Cognito ---
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_REDIRECT_URI=
